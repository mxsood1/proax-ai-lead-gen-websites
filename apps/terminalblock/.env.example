# Copy to .env.local and fill in. Never commit real values.
# Everything external is OFF until its settings are filled in.

# --- Site ---
SITE_ID=terminalblock
SITE_URL=http://localhost:3000

# --- Sourcing desk (internal lead dashboard at /desk) ---
DESK_PASSWORD=            # 12+ characters
DESK_SECRET=              # 32+ random characters, signs the login cookie

# --- AI (Claude). Leave empty to keep AI off. ---
ANTHROPIC_API_KEY=

# --- Lead storage. Empty = local files in .data/ ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY= # server-side only, never exposed to the browser
SUPABASE_BUCKET=rfq-files

# --- Lead alert email. Nothing is sent unless EMAIL_DELIVERY=on ---
EMAIL_DELIVERY=off
RESEND_API_KEY=
LEAD_ALERT_TO=            # comma-separated internal addresses
LEAD_ALERT_FROM=          # e.g. "TerminalBlock.ca <desk@terminalblock.ca>" (domain must be verified)

# --- Content: approved drafts only appear on the site when this is on ---
CONTENT_PUBLISHING=off
# Weekly AI article job (vercel.json cron, Mondays ~9 am Toronto). The route is disabled until
# this is set. Long random value, 16+ characters; Vercel sends it automatically as a Bearer token.
CRON_SECRET=
# The weekly job pauses while this many articles are waiting for review (default 4)
CONTENT_MAX_WAITING=4
